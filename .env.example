PORT=3000
NODE_ENV=development
# sqlite (padrão, dev/testes) ou supabase (produção na Vercel)
DB_DRIVER=sqlite
DB_PATH=./data/4tb.sqlite
# Obrigatória quando DB_DRIVER=supabase — connection string do Supabase (session mode, porta 5432)
SUPABASE_DB_URL=
JWT_SECRET=alterar-este-segredo
JWT_EXPIRES_IN=8h
COOKIE_NAME=4tb_token
DEFAULT_ADMIN_USER=delegado
DEFAULT_ADMIN_PASS=alterar-esta-senha
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880
